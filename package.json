{
  "name": "watchly",
  "private": true,
  "scripts": {
    "test": "npm run test:backend",
    "test:backend": "npm --prefix backend test",
    "test:unit": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "test:database": "npm --prefix backend run test:database",
    "test:functional": "playwright test",
    "test:all": "npm run test:backend && npm run test:functional"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
